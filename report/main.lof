\contentsline {figure}{\numberline {18}{\ignorespaces Illustration of the "Local Minimum Trap" where the solver converges to a suboptimal trajectory rather than the target equilibrium.}}{17}{figure.caption.19}%
\contentsline {figure}{\numberline {19}{\ignorespaces Cost function evolution during failure. The cost converges to a steady value, concealing the failure to reach the target.}}{18}{figure.caption.20}%
\contentsline {figure}{\numberline {20}{\ignorespaces Descent direction norm. The algorithm mathematically converges (norm $\to 0$), but to an incorrect solution.}}{18}{figure.caption.21}%
\contentsline {figure}{\numberline {21}{\ignorespaces Evolution of the trajectory during the Dynamic Horizon Extension process. The system incrementally "learns" the complex maneuver.}}{20}{figure.caption.22}%
\contentsline {figure}{\numberline {22}{\ignorespaces Step-wise evolution of the cost function. Each "step" corresponds to a horizon extension.}}{21}{figure.caption.23}%
\contentsline {figure}{\numberline {23}{\ignorespaces Norm of the descent direction. Spikes indicate the start of a new extension phase, followed by rapid convergence.}}{21}{figure.caption.24}%
